\section*{Lesson Plan: Fractions}
\textbf{Objective:} Students will be able to represent equivalent fractions, convert between improper fractions and mixed numbers, and apply these foundational skills to solve problems.

\subsection*{Key Mathematical Principles}
\begin{itemize}
    \item \textbf{Equivalent Fractions:} Fractions that look different but represent the exact same value (e.g., $\frac{1}{2} = \frac{2}{4}$). These are generated by multiplying or dividing the numerator and the denominator by the exact same number.
    \item \textbf{Proper vs. Improper Fractions:} A proper fraction has a numerator that is smaller than its denominator (e.g., $\frac{3}{4}$). An improper fraction has a numerator equal to or greater than its denominator (e.g., $\frac{5}{4}$), representing a value equal to or greater than one whole.
    \item \textbf{Mixed Numbers:} A representation that combines a whole number with a proper fraction (e.g., $1 \frac{1}{4}$).
\end{itemize}

\vspace{0.5cm}
\hrule
\vspace{0.5cm}

\section*{Practice Questions}

\subsection*{Part A: Equivalent Fractions}
\begin{enumerate}
    \item Find two equivalent fractions for $\frac{3}{5}$.
    \item Simplify the fraction $\frac{12}{16}$ to its lowest terms.
    \item Fill in the blank to make the fractions equivalent: $\frac{4}{7} = \frac{x}{21}$.
\end{enumerate}

\subsection*{Part B: Mixed Numbers and Improper Fractions}
\begin{enumerate}
    \setcounter{enumi}{3}
    \item Convert the improper fraction $\frac{11}{3}$ into a mixed number.
    \item Convert the mixed number $3 \frac{2}{5}$ into an improper fraction.
    \item Convert the improper fraction $\frac{17}{4}$ into a mixed number.
\end{enumerate}

\subsection*{Part C: Application and Word Problems}
\begin{enumerate}
    \setcounter{enumi}{6}
    \item Sarah baked a pie and cut it into 8 equal slices. She ate 2 slices. Write this fraction and find an equivalent fraction with a denominator of 4.
    \item A recipe calls for $\frac{9}{2}$ cups of water. How many whole cups and half cups is this? Express your answer as a mixed number.
    \item John walked $2 \frac{3}{4}$ kilometers on Monday. Express this distance as an improper fraction.
\end{enumerate}

% ---------------------------------------------------------
% Walkthroughs Section placed at the end of the document
% ---------------------------------------------------------
\newpage
\section*{Step-by-Step Walkthroughs (Solutions)}

\textbf{Question 1:} Find two equivalent fractions for $\frac{3}{5}$.\\
\textit{Walkthrough:}
\begin{itemize}
    \item \textbf{Step 1:} To find an equivalent fraction, you must multiply both the top (numerator) and bottom (denominator) by the same number.
    \item \textbf{Step 2:} Multiply by 2: $\frac{3 \times 2}{5 \times 2} = \frac{6}{10}$.
    \item \textbf{Step 3:} Multiply by 3: $\frac{3 \times 3}{5 \times 3} = \frac{9}{15}$.
    \item \textbf{Final Answer:} $\frac{6}{10}$ and $\frac{9}{15}$ (other answers are acceptable as long as the rule was applied correctly).
\end{itemize}

\vspace{0.3cm}
\textbf{Question 2:} Simplify the fraction $\frac{12}{16}$ to its lowest terms.\\
\textit{Walkthrough:}
\begin{itemize}
    \item \textbf{Step 1:} Find the greatest number that divides evenly into both 12 and 16. The greatest common divisor is 4.
    \item \textbf{Step 2:} Divide both the numerator and the denominator by 4.
    \item \textbf{Step 3:} $\frac{12 \div 4}{16 \div 4} = \frac{3}{4}$.
    \item \textbf{Final Answer:} $\frac{3}{4}$.
\end{itemize}

\vspace{0.3cm}
\textbf{Question 3:} Fill in the blank: $\frac{4}{7} = \frac{x}{21}$.\\
\textit{Walkthrough:}
\begin{itemize}
    \item \textbf{Step 1:} Look at the denominators to find the multiplier. Ask yourself: ``How do I get from 7 to 21?'' You multiply by 3 ($7 \times 3 = 21$).
    \item \textbf{Step 2:} The golden rule says whatever you do to the bottom, you must do to the top. Multiply the numerator by 3.
    \item \textbf{Step 3:} $4 \times 3 = 12$.
    \item \textbf{Final Answer:} $x = 12$.
\end{itemize}

\vspace{0.3cm}
\textbf{Question 4:} Convert the improper fraction $\frac{11}{3}$ into a mixed number.\\
\textit{Walkthrough:}
\begin{itemize}
    \item \textbf{Step 1:} Treat the fraction line like a division symbol. Divide the numerator (11) by the denominator (3).
    \item \textbf{Step 2:} $11 \div 3 = 3$ with a remainder of 2.
    \item \textbf{Step 3:} The answer (3) becomes your whole number. The remainder (2) becomes your new numerator. The denominator stays exactly the same (3).
    \item \textbf{Final Answer:} $3 \frac{2}{3}$.
\end{itemize}

\vspace{0.3cm}
\textbf{Question 5:} Convert the mixed number $3 \frac{2}{5}$ into an improper fraction.\\
\textit{Walkthrough:}
\begin{itemize}
    \item \textbf{Step 1:} Multiply the whole number by the denominator: $3 \times 5 = 15$.
    \item \textbf{Step 2:} Add the numerator to that result: $15 + 2 = 17$. This is your new numerator.
    \item \textbf{Step 3:} Place this new numerator over the original denominator.
    \item \textbf{Final Answer:} $\frac{17}{5}$.
\end{itemize}

\vspace{0.3cm}
\textbf{Question 6:} Convert the improper fraction $\frac{17}{4}$ into a mixed number.\\
\textit{Walkthrough:}
\begin{itemize}
    \item \textbf{Step 1:} Divide 17 by 4. 
    \item \textbf{Step 2:} 4 goes into 17 four times ($4 \times 4 = 16$), which leaves a remainder of 1.
    \item \textbf{Step 3:} The whole number is 4, and the remainder 1 goes over the original denominator 4.
    \item \textbf{Final Answer:} $4 \frac{1}{4}$.
\end{itemize}

\vspace{0.3cm}
\textbf{Question 7:} Sarah baked a pie and cut it into 8 equal slices. She ate 2 slices. Write this fraction and find an equivalent fraction with a denominator of 4.\\
\textit{Walkthrough:}
\begin{itemize}
    \item \textbf{Step 1:} Write the starting fraction. 2 out of 8 slices is $\frac{2}{8}$.
    \item \textbf{Step 2:} We need to turn the denominator 8 into a 4. To do this, we divide by 2 ($8 \div 2 = 4$).
    \item \textbf{Step 3:} Apply the same division to the numerator: $2 \div 2 = 1$.
    \item \textbf{Final Answer:} The original fraction is $\frac{2}{8}$ and the equivalent is $\frac{1}{4}$.
\end{itemize}

\vspace{0.3cm}
\textbf{Question 8:} A recipe calls for $\frac{9}{2}$ cups of water. Express your answer as a mixed number.\\
\textit{Walkthrough:}
\begin{itemize}
    \item \textbf{Step 1:} Divide the numerator (9) by the denominator (2).
    \item \textbf{Step 2:} $9 \div 2 = 4$ with a remainder of 1.
    \item \textbf{Step 3:} Write the whole number (4), and put the remainder (1) over the original denominator (2).
    \item \textbf{Final Answer:} $4 \frac{1}{2}$ cups.
\end{itemize}

\vspace{0.3cm}
\textbf{Question 9:} John walked $2 \frac{3}{4}$ kilometers on Monday. Express this distance as an improper fraction.\\
\textit{Walkthrough:}
\begin{itemize}
    \item \textbf{Step 1:} Multiply the whole number (2) by the denominator (4): $2 \times 4 = 8$.
    \item \textbf{Step 2:} Add the numerator (3): $8 + 3 = 11$.
    \item \textbf{Step 3:} Place 11 over the original denominator (4).
    \item \textbf{Final Answer:} $\frac{11}{4}$ kilometers.
\end{itemize}

